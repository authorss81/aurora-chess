{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora Chess",
  "version": "0.1.0",
  "identifier": "dev.aurora.chess",
  "build": {
    "frontendDist": "..",
    "devUrl": "http://localhost:8420",
    "beforeDevCommand": "node server.js",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Aurora Chess",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "copyright": "Aurora Chess Project",
    "category": "Game",
    "shortDescription": "Chess with an engine built from scratch",
    "longDescription": "A chess application whose engine - move generation, evaluation and alpha-beta search - was written from scratch in Rust and verified with perft to depth 6."
  }
}